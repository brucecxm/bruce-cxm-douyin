{
	// 左侧窗口配置（多窗口应用时使用）
	"leftWindow": {
		"path": "windows/left-window.vue",
		"style": {
			"width": "350px"
		}
	},
	// 顶部窗口配置（多窗口应用时使用）
	"topWindow": {
		"path": "windows/top-window.vue",
		"style": {
			"height": "60px"
		}
	},
