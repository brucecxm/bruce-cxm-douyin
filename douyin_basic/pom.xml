<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.example</groupId>
        <artifactId>douyin_backend</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>douyin_basic</artifactId>
    <packaging>pom</packaging>
    <modules>
        <module>douyin_file_starter</module>
        <module>douyin-dao-service</module>
        <module>douyin_model</module>
    </modules>


    <!--    这样做的效果是：虽然插件仍然存在，但它不会在任何生命周期阶段被执行，达到了“排除”的效果。-->
<dependencies>
    <dependency>
        <groupId>org.example</groupId>
        <artifactId>douyin_feign</artifactId>
        <version>1.0-SNAPSHOT</version>
    </dependency>
    <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
    <dependency>
        <groupId>com.baomidou</groupId>
        <artifactId>mybatis-plus-boot-starter</artifactId>
        <version>3.4.2</version>
    </dependency>
</dependencies>
    <build>
        <plugins>
            <!-- 普通 Maven 插件打 JAR 包 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <outputDirectory>${project.basedir}/../../jar</outputDirectory>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <dependencyManagement>


    <dependencies>
    <dependency>
        <groupId>org.example</groupId>
        <artifactId>douyin_model</artifactId>
        <version>1.0-SNAPSHOT</version>
    </dependency>
    <dependency>
        <groupId>org.example</groupId>
        <artifactId>douyin-id-service</artifactId>
        <version>1.0-SNAPSHOT</version>
    </dependency>
    <dependency>
        <groupId>org.example</groupId>
        <artifactId>douyin_file_starter</artifactId>
        <version>1.0-SNAPSHOT</version>
    </dependency>
    </dependencies>
    </dependencyManagement>
</project>
